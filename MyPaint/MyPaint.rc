/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINMENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새로 만들기(&N)\tCtrl+N",       ID_FILE_NEW
        MENUITEM "열기(&O)...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM "저장(&S)\tCtrl+S",              ID_FILE_SAVE
        MENUITEM "다른 이름으로 저장(&A)...\tF12", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)",                   ID_APP_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "실행 취소(&U)\tCtrl+Z",         ID_EDIT_UNDO
        MENUITEM "다시 실행(&R)\tCtrl+Y",         ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)\tCtrl+X",          ID_EDIT_CUT
        MENUITEM "복사(&C)\tCtrl+C",              ID_EDIT_COPY
        MENUITEM "붙여넣기(&P)\tCtrl+V",          ID_EDIT_PASTE
        MENUITEM "삭제(&D)\tDel",                 ID_EDIT_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "모두 선택(&A)\tCtrl+A",         ID_EDIT_SELECT_ALL
    END
    POPUP "이미지(&I)"
    BEGIN
        MENUITEM "자르기(&C)\tCtrl+Shift+X",      ID_IMAGE_CROP
        MENUITEM "크기 조정 및 기울이기(&R)...\tCtrl+W", ID_IMAGE_RESIZE
        MENUITEM "이미지 속성(&P)...\tCtrl+E",    ID_IMAGE_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "오른쪽으로 90° 회전",           ID_IMAGE_ROTATE_RIGHT
        MENUITEM "왼쪽으로 90° 회전",             ID_IMAGE_ROTATE_LEFT
        MENUITEM "180° 회전",                     ID_IMAGE_ROTATE_180
        MENUITEM "좌우 대칭",                     ID_IMAGE_FLIP_H
        MENUITEM "상하 대칭",                     ID_IMAGE_FLIP_V
        MENUITEM SEPARATOR
        MENUITEM "색 반전(&I)\tCtrl+Shift+I",     ID_IMAGE_INVERT
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "확대(&I)\tCtrl+PgUp",           ID_VIEW_ZOOM_IN
        MENUITEM "축소(&O)\tCtrl+PgDn",           ID_VIEW_ZOOM_OUT
        MENUITEM "100%(&1)\tCtrl+1",              ID_VIEW_ZOOM_100
    END
    POPUP "공유(&S)"
    BEGIN
        MENUITEM "공유 시작(&S)...",               ID_SHARE_START
        MENUITEM "공유 참가(&J)...",               ID_SHARE_JOIN
        MENUITEM "공유 끝내기 / 나가기(&E)",       ID_SHARE_STOP
        MENUITEM SEPARATOR
        MENUITEM "참가자와 채팅 창(&C)",           ID_SHARE_CHAT
    END
END

