IDR_MAINFRAME           ICON                    "res\\MyPaint.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_MYPAINT_DIALOG DIALOGEX 0, 0, 480, 300
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "MyPaint"
MENU IDR_MAINMENU
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
END

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINMENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새로 만들기(&N)\tCtrl+N",       ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)",                   ID_APP_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "실행 취소(&U)\tCtrl+Z",         ID_EDIT_UNDO
        MENUITEM "다시 실행(&R)\tCtrl+Y",         ID_EDIT_REDO
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "확대(&I)\tCtrl+PgUp",           ID_VIEW_ZOOM_IN
        MENUITEM "축소(&O)\tCtrl+PgDn",           ID_VIEW_ZOOM_OUT
        MENUITEM "100%(&1)\tCtrl+1",              ID_VIEW_ZOOM_100
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_ACCELERATOR ACCELERATORS
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
    "Y",            ID_EDIT_REDO,           VIRTKEY, CONTROL, NOINVERT
    VK_PRIOR,       ID_VIEW_ZOOM_IN,        VIRTKEY, CONTROL, NOINVERT
    VK_NEXT,        ID_VIEW_ZOOM_OUT,       VIRTKEY, CONTROL, NOINVERT
    "1",            ID_VIEW_ZOOM_100,       VIRTKEY, CONTROL, NOINVERT
END

